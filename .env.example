# Host/Port on which this backend app is hosted
PORT=8000
HOST='http://127.0.0.1'

# Environment category (limit to development OR production)
NODE_ENV=development

# Environment name (varies by env type)
ENV_NAME=development

# Database
DATABASE_URL=''

# Arcjet
ARCJET_KEY=
ARCJET_ENV=development

# Application
FRONTEND_URL='http://localhost:5173'
ANALYSIS_SERVICE_URL='http://localhost:5000/'

# Used to create an obscure health-check endpoint difficult for bots to find
HEALTH_CHECK_URL_SLUG=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL='http://127.0.0.1:8000/auth'

# API keys
RECOMMEND_ENROLLMENTS_API_USERNAME=
RECOMMEND_ENROLLMENTS_API_PASSWORD=

# Passwords for seeding test users
SEED_USER_{FIRSTNAME}_{LASTNAME}_{ENVIRONMENT-TYPE}_PWD=