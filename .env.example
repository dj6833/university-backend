# Environment category (limit to development OR production)
NODE_ENV=development

# Environment name (varies by env type)
ENV_NAME=development

# Database
DATABASE_URL=''

# Arcjet
ARCJET_KEY=
ARCJET_ENV=development

# Application
FRONTEND_URL='http://localhost:5173'
ANALYSIS_SERVICE_URL='http://localhost:5000/'

# Used to create an obscure health-check endpoint difficult for bots to find
HEALTH_CHECK_URL_SLUG=

# Better Auth
BETTER_AUTH_SECRET=

# API keys
RECOMMEND_ENROLLMENTS_API_USERNAME=
RECOMMEND_ENROLLMENTS_API_PASSWORD=

# RabbitMQ
CLOUDAMQP_URL=

# Cloudflare R2 Storage
R2_PRIVATE_BUCKET_NAME=university-dev
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=